# Supabase — configurar antes de ligar a produção
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Router: "hash" (omissão, qualquer alojamento estático) ou "browser"
# (URLs limpas — exige rewrites do servidor para index.html em produção).
VITE_ROUTER_MODE=hash

# URL canónica do sítio (SEO, sitemap, Open Graph).
VITE_SITE_URL=https://melhoresdoano.pt

# NUNCA expor a service_role key no frontend.
# A service_role só é usada nas Edge Functions (Fase 2, votação).
#
# Segredos Phase 2 (configurar como Edge Secrets no dashboard Supabase —
# NUNCA como VITE_* nem em site_settings):
#   supabase secrets set VOTE_HASH_SECRET="<64+ caracteres hex aleatórios>"
#   supabase secrets set TURNSTILE_SECRET_KEY="<segredo-turnstile>"  # só se turnstile_enabled=true
# Deploy da votação:
#   supabase functions deploy cast-vote --no-verify-jwt
